# Copy to backend/.env and fill in. .env is gitignored and must never be
# committed. Real environment variables override this file, so a container or
# service unit can set values without editing it.

# --- required ---------------------------------------------------------------
# The MySQL password. There is no default: the app refuses to start without it
# (unless DB_ENABLED=0). Use a password that has never been committed anywhere.
DB_PASS=

# --- database ---------------------------------------------------------------
DB_ENABLED=1
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_NAME=instream_overlay

# --- addressing -------------------------------------------------------------
# The address a VIEWER can reach, not the one we bind to: every variant,
# rendition and segment URL written into a manifest is built from it.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- streaming --------------------------------------------------------------
# Segments of output held behind the origin's live edge. This is the headroom
# the transcoder gets; keep it below the origin's own window depth.
OVERLAY_BUFFER_SEGMENTS=6
OVERLAY_HEVC_EXTRA_BUFFER=3

# --- transcoding ------------------------------------------------------------
# none | qsv (Intel Quick Sync) | nvenc (NVIDIA). A hardware encode that fails
# at runtime is retried in software automatically.
OVERLAY_HWACCEL=none
OVERLAY_MAX_WORKERS=6
OVERLAY_ENCODER_THREADS=1
OVERLAY_ENCODER_CRF=28
OVERLAY_ENCODER_PRESET=ultrafast

# --- storage and retention --------------------------------------------------
# Where transcoded segments and uploaded overlay art live. Defaults to
# backend/data. Must persist across reboots — do not point it at a temp dir.
# OVERLAY_DATA_DIR=/var/lib/instream-overlay

# Transcoded segments older than this are swept (seconds). They are only needed
# while inside the output DVR window; without this the disk fills.
OVERLAY_SEGMENT_RETENTION=1800
OVERLAY_RETENTION_INTERVAL=300
OVERLAY_MIN_FREE_DISK_MB=2048

# --- safety -----------------------------------------------------------------
# Verify the origin's TLS certificate. Turn off only for an origin whose chain
# genuinely cannot be validated here, and treat that as temporary.
OVERLAY_VERIFY_TLS=1

# --- logging ----------------------------------------------------------------
OVERLAY_LOG_LEVEL=INFO
